PORT=3100
# Comma-separated list of trusted device tokens for initial local-device authentication.
# Example: DEVICE_TOKENS=desktop-dev-token,web-dev-token
DEVICE_TOKENS=desktop-dev-token
# Comma-separated token scope config: token:scopeA|scopeB,token2:scopeA
DEVICE_TOKEN_SCOPES=desktop-dev-token:integrations:read|integrations:invoke:system-info|telegram:read|telegram:poll|telegram:send|telegram:send:voice

# M2 persistence files (relative to apps/companion-backend by default)
DATA_PATH_CHATS=./.data/chats.json
DATA_PATH_MEMORY=./.data/memory.json
DATA_PATH_REMINDERS=./.data/reminders.json
DATA_PATH_TELEGRAM=./.data/telegram.json



# Telegram integration (M5): polling inbound messages + outbound send path.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Optional: restrict inbound/outbound to a specific chat id.
TELEGRAM_CHAT_ID=
# Session id where inbound Telegram messages are persisted as user messages.
TELEGRAM_INBOUND_SESSION_ID=
TELEGRAM_POLL_INTERVAL_SECONDS=30
# If true and voiceUrl is provided to /api/telegram/send, a voice attachment is sent too.
TELEGRAM_TTS_ENABLED=false

# Jellyfin awareness (M3/M4 integration): polls current media and optionally emits a spontaneous character comment.
JELLYFIN_AWARENESS_ENABLED=false
JELLYFIN_BASE_URL=http://localhost:8096
JELLYFIN_API_KEY=
# Optional: only inspect media currently playing for this Jellyfin user id.
JELLYFIN_USER_ID=
# Required when awareness is enabled: chat session that receives spontaneous assistant comments.
JELLYFIN_TARGET_SESSION_ID=
# Poll every N seconds (default 300 = 5 minutes).
JELLYFIN_AWARENESS_INTERVAL_SECONDS=300
# Chance [0..1] to trigger awareness each tick.
JELLYFIN_AWARENESS_TRIGGER_CHANCE=0.5
# Suppress repeated comments for same currently playing media item.
JELLYFIN_SUPPRESS_SAME_MEDIA=true
# Hidden prompt passed to the LLM; placeholders: {{mediaName}}, {{mediaType}}, {{artist}}, {{deviceName}}.
JELLYFIN_AWARENESS_PROMPT_TEMPLATE=You are roleplaying as the current character. The user is currently consuming {{mediaType}} named "{{mediaName}}" by "{{artist}}" on {{deviceName}}. React naturally in-character in 1-2 sentences and do not mention raw JSON or APIs.
# Optional OpenAI-compatible endpoint for character comment generation.
JELLYFIN_AWARENESS_LLM_BASE_URL=
JELLYFIN_AWARENESS_LLM_MODEL=
JELLYFIN_AWARENESS_LLM_API_KEY=

# Deterministic rollover threshold for starting a fresh session context.
SESSION_MAX_MESSAGES=20
